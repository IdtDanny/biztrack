// ============================================================
// GENERATOR & DATASOURCE (Prisma 7 compatible)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 1. SYSTEM & TENANT
// ============================================================

model Tenant {
  id         String   @id @default(cuid())
  name       String
  subdomain  String?  @unique
  logoUrl    String?
  phone      String?
  email      String?
  address    String?
  tin        String?
  vatEnabled Boolean  @default(true)
  currency   String   @default("RWF")
  timezone   String   @default("Africa/Kigali")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations – opposite fields for all child models
  users               User[]
  auditLogs           AuditLog[]
  brands              Brand[]
  categories          Category[]
  customers           Customer[]
  expenses            Expense[]
  goodsReceipts       GoodsReceipt[]
  invoices            Invoice[]
  notifications       Notification[]
  payments            Payment[]
  products            Product[]
  proformas           ProformaInvoice[]
  purchaseOrders      PurchaseOrder[]
  quotations          Quotation[]
  stockMovements      StockMovement[]
  stockTransfers      StockTransfer[]
  suppliers           Supplier[]
  taxRates            TaxRate[]
  tenantSettings      TenantSetting[]
  tenantSubscriptions TenantSubscription[]
  units               UnitOfMeasure[]
  userTenants         UserTenant[]
  warehouses          Warehouse[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  firstName    String
  lastName     String
  phone        String?
  avatar       String?
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships   UserTenant[]
  auditLogs     AuditLog[]
  notifications Notification[]
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  tenantId      String?
}

model UserTenant {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, tenantId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments UserTenant[]
}

// ============================================================
// 2. CORE BUSINESS ENTITIES
// ============================================================

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Brand {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]
}

model Product {
  id              String   @id @default(cuid())
  tenantId        String
  sku             String?  @unique
  barcode         String?
  name            String
  description     String?
  categoryId      String?
  brandId         String?
  unitOfMeasureId String?
  taxCategory     String?
  unitPrice       Float    @default(0)
  costPrice       Float    @default(0)
  reorderPoint    Int      @default(0)
  isActive        Boolean  @default(true)
  isService       Boolean  @default(false)
  images          String[]
  variants        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  category Category?      @relation(fields: [categoryId], references: [id])
  brand    Brand?         @relation(fields: [brandId], references: [id])
  unit     UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])

  warehouseStocks   WarehouseStock[]
  stockMovements    StockMovement[]
  quotationItems    QuotationItem[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  proformaItems     ProformaInvoiceItem[]
  stockTransfers    StockTransfer[]
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  location  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  stocks         WarehouseStock[]
  fromTransfers  StockTransfer[]  @relation("FromTransfers")
  toTransfers    StockTransfer[]  @relation("ToTransfers")
  stockMovements StockMovement[]
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId, batchNumber])
}

model StockMovement {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String
  warehouseId  String
  quantity     Int
  movementType String
  referenceId  String?
  notes        String?
  createdAt    DateTime @default(now())
  createdBy    String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
}

model StockTransfer {
  id              String    @id @default(cuid())
  tenantId        String
  fromWarehouseId String
  toWarehouseId   String
  productId       String
  quantity        Int
  status          String    @default("PENDING")
  notes           String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  createdBy       String?

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  fromWarehouse Warehouse @relation("FromTransfers", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("ToTransfers", fields: [toWarehouseId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
}

// ============================================================
// 3. CUSTOMERS & SUPPLIERS
// ============================================================

model Customer {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  companyName    String?
  tin            String?
  phone          String
  email          String?
  address        String?
  notes          String?
  creditLimit    Float?
  currentBalance Float    @default(0)
  isActive       Boolean  @default(true)
  groupId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  invoices   Invoice[]
  quotations Quotation[]
  proformas  ProformaInvoice[]
  // payments removed – linked via Invoice
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  tin            String?
  phone          String
  email          String?
  address        String?
  notes          String?
  currentBalance Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
}

// ============================================================
// 4. SALES: QUOTATIONS, PROFORMA, INVOICES
// ============================================================

model Quotation {
  id           String    @id @default(cuid())
  tenantId     String
  number       String    @unique
  customerId   String
  issueDate    DateTime  @default(now())
  validUntil   DateTime?
  status       String    @default("DRAFT")
  total        Float
  tax          Float
  discount     Float     @default(0)
  discountType String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  items    QuotationItem[]
  invoices Invoice[]
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Float
  discount    Float   @default(0)
  taxRate     Float
  total       Float
  notes       String?

  quotation Quotation @relation(fields: [quotationId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
}

model ProformaInvoice {
  id           String   @id @default(cuid())
  tenantId     String
  number       String   @unique
  customerId   String
  issueDate    DateTime @default(now())
  status       String   @default("DRAFT")
  total        Float
  tax          Float
  discount     Float    @default(0)
  discountType String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  customer Customer              @relation(fields: [customerId], references: [id])
  // Removed invalid relation: invoice Invoice? (no invoiceId field)
  // The connection is defined from the Invoice side via proformaId
  items    ProformaInvoiceItem[]
  invoices Invoice[]
}

model ProformaInvoiceItem {
  id         String  @id @default(cuid())
  proformaId String
  productId  String
  quantity   Int
  unitPrice  Float
  discount   Float   @default(0)
  taxRate    Float
  total      Float
  notes      String?

  proforma ProformaInvoice @relation(fields: [proformaId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
}

model Invoice {
  id            String   @id @default(cuid())
  tenantId      String
  number        String   @unique
  customerId    String
  invoiceType   String   @default("TAX_INVOICE")
  issueDate     DateTime @default(now())
  dueDate       DateTime
  status        String   @default("DRAFT")
  total         Float
  tax           Float
  discount      Float    @default(0)
  discountType  String?
  notes         String?
  paymentStatus String   @default("UNPAID")
  paidAmount    Float    @default(0)
  balanceDue    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  proformaId  String?
  quotationId String?

  proforma  ProformaInvoice? @relation(fields: [proformaId], references: [id])
  quotation Quotation?       @relation(fields: [quotationId], references: [id])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String
  quantity  Int
  unitPrice Float
  discount  Float   @default(0)
  taxRate   Float
  total     Float
  notes     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  amount      Float
  paymentDate DateTime @default(now())
  method      String
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ============================================================
// 5. PURCHASES
// ============================================================

model PurchaseOrder {
  id               String    @id @default(cuid())
  tenantId         String
  number           String    @unique
  supplierId       String
  orderDate        DateTime  @default(now())
  expectedDelivery DateTime?
  status           String    @default("DRAFT")
  total            Float
  tax              Float
  discount         Float     @default(0)
  discountType     String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]
  goodsReceipts GoodsReceipt[]
}

model PurchaseItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Int
  unitCost         Float
  discount         Float   @default(0)
  taxRate          Float
  total            Float
  notes            String?
  receivedQuantity Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  receiptDate     DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  createdBy       String?

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id             String    @id @default(cuid())
  goodsReceiptId String
  productId      String
  quantity       Int
  unitCost       Float
  batchNumber    String?
  expiryDate     DateTime?
  notes          String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
}

// ============================================================
// 6. EXPENSES & FINANCE
// ============================================================

model Expense {
  id            String   @id @default(cuid())
  tenantId      String
  category      String
  amount        Float
  date          DateTime @default(now())
  description   String?
  paymentMethod String
  reference     String?
  receiptUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ============================================================
// 7. TAX CONFIGURATION
// ============================================================

model TaxRate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  rate      Float
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  appliesTo String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ============================================================
// 8. NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
}

// ============================================================
// 9. SUBSCRIPTION & PREMIUM FEATURES
// ============================================================

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Float
  currency        String   @default("RWF")
  billingInterval String
  features        Json
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantSubscriptions TenantSubscription[]
}

model TenantSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)
  autoRenew Boolean  @default(true)
  paymentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

// ============================================================
// 10. SYSTEM SETTINGS
// ============================================================

model TenantSetting {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}
